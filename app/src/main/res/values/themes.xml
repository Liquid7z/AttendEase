<resources xmlns:tools="http://schemas.android.com/tools">

    <!-- Main App Theme -->
    <style name="Base.Theme.AttendEase"
        parent="Theme.Material3.DayNight.NoActionBar">

        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>

    </style>

    <style name="Theme.AttendEase"
        parent="Base.Theme.AttendEase" />

    <!-- Splash Theme -->
    <style name="Theme.AttendEase.Splash"
        parent="Theme.SplashScreen">

        <item name="windowSplashScreenBackground">
            #120B25
        </item>

        <item name="windowSplashScreenAnimatedIcon">
            @mipmap/ic_launcher
        </item>

        <item name="postSplashScreenTheme">
            @style/Theme.AttendEase
        </item>

    </style>

</resources>