<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="20dp"
    android:orientation="vertical">
<TextView
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginTop="24dp"
    android:text="Safe Bunk Calculator"
    android:textSize="30sp"
    android:textStyle="bold"/>

    <EditText
        android:id="@+id/etConducted"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Classes Conducted"
        android:inputType="number"/>

    <EditText
        android:id="@+id/etAttended"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Classes Attended"
        android:inputType="number"/>

    <EditText
        android:id="@+id/etTarget"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Target Attendance %"
        android:inputType="numberDecimal"/>

    <Button
        android:id="@+id/btnCalculate"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Calculate Safe Bunks"/>

    <TextView
        android:id="@+id/tvResult"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:paddingTop="20dp"/>

</LinearLayout>